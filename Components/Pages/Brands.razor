@page "/brands"
@rendermode InteractiveServer
@using ProductManagement.Features.Data.Models
@using ProductManagement.Features.Services.Interfaces
@inject IBrandService BrandService

<PageTitle>Brands</PageTitle>

<h1><i class="bi bi-tag me-2"></i>Brands</h1>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
    </div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
    </div>
}

<div class="mb-3">
    <button class="btn btn-primary" @onclick="ShowAddModal">Add New Brand</button>
</div>

@if (isLoading)
{
    <p>Loading...</p>
}
else if (brands == null || !brands.Any())
{
    <p>No brands found.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Status</th>
                <th>Created At</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var brand in brands)
            {
                <tr>
                    <td>@brand.Name</td>
                    <td>@brand.Description</td>
                    <td>
                        @if (brand.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td>@brand.CreatedAt.ToString("MM/dd/yyyy")</td>
                    <td>
                        <button class="btn btn-sm btn-info" @onclick="() => EditBrand(brand)">Edit</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteBrand(brand.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditMode ? "Edit Brand" : "Add New Brand")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input class="form-control" @bind="editingBrand.Name" placeholder="Enter brand name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" @bind="editingBrand.Description" placeholder="Enter description" rows="3"></textarea>
                    </div>
                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" @bind="editingBrand.IsActive" />
                        <label class="form-check-label">Active</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveBrand">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IEnumerable<Brand>? brands;
    private bool isLoading = true;
    private string? errorMessage;
    private string? successMessage;
    private bool showModal = false;
    private bool isEditMode = false;
    private Brand editingBrand = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        brands = await BrandService.GetAllBrandsAsync();
        isLoading = false;
    }

    private void ShowAddModal()
    {
        isEditMode = false;
        editingBrand = new Brand { IsActive = true };
        showModal = true;
        errorMessage = null;
    }

    private void EditBrand(Brand brand)
    {
        isEditMode = true;
        editingBrand = new Brand
        {
            Id = brand.Id,
            Name = brand.Name,
            Description = brand.Description,
            IsActive = brand.IsActive,
            CreatedAt = brand.CreatedAt
        };
        showModal = true;
        errorMessage = null;
    }

    private async Task SaveBrand()
    {
        if (string.IsNullOrWhiteSpace(editingBrand.Name))
        {
            errorMessage = "Brand name is required.";
            return;
        }

        var result = isEditMode
            ? await BrandService.UpdateBrandAsync(editingBrand)
            : await BrandService.CreateBrandAsync(editingBrand);

        if (result.Success)
        {
            successMessage = isEditMode ? "Brand updated successfully." : "Brand added successfully.";
            showModal = false;
            await LoadData();
        }
        else
        {
            errorMessage = result.Message;
        }
    }

    private async Task DeleteBrand(int id)
    {
        var result = await BrandService.DeleteBrandAsync(id);
        if (result.Success)
        {
            successMessage = "Brand deleted successfully.";
            await LoadData();
        }
        else
        {
            errorMessage = result.Message;
        }
    }

    private void CloseModal()
    {
        showModal = false;
        errorMessage = null;
    }
}
